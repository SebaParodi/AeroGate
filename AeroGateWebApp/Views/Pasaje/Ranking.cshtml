@model List<VMRankingDestino>
@{
    ViewData["Title"] = "Ranking de Destinos";
}

<h2 class="mb-3">Ranking de Destinos más Vendidos</h2>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Código IATA</th>
            <th>Ciudad</th>
            <th>País</th>
            <th>Pasajes vendidos</th>
        </tr>
    </thead>
    <tbody>
        @{ int pos = 1; }
        @foreach (var r in Model)
        {
            <tr>
                <td><strong>@(pos++)</strong></td>
                <td><span class="badge bg-primary">@r.CodigoIATA</span></td>
                <td>@r.Ciudad</td>
                <td>@r.Pais</td>
                <td>@r.CantidadPasajes</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted">Todavía no hay pasajes vendidos.</td></tr>
        }
    </tbody>
</table>
