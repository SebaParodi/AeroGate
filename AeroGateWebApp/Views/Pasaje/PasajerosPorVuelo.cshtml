@model List<VMCliente>
@{
    ViewData["Title"] = "Pasajeros por Vuelo";
}

<h2 class="mb-3">Pasajeros por Vuelo</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <select name="vueloId" class="form-select" asp-items="ViewBag.Vuelos">
            <option value="">Seleccionar un vuelo...</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Consultar</button>
    </div>
</form>

@if (ViewBag.VueloId != null)
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Pasajero</th>
                <th>Email</th>
                <th>Documento</th>
                <th>Categoría</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.NombreCompleto</td>
                    <td>@c.Email</td>
                    <td>@c.Documento</td>
                    <td><span class="badge bg-info text-dark">@c.Categoria</span></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center text-muted">El vuelo no tiene pasajes vendidos.</td></tr>
            }
        </tbody>
    </table>
}
