@model List<VMAeropuerto>
@{
    ViewData["Title"] = "Aeropuertos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Catálogo de Aeropuertos</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Aeropuerto</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="filtro" value="@ViewBag.Filtro" class="form-control"
               placeholder="Buscar por código, ciudad o país" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Código IATA</th>
            <th>Nombre</th>
            <th>Ciudad</th>
            <th>País</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td><span class="badge bg-primary">@a.CodigoIATA</span></td>
                <td>@a.Nombre</td>
                <td>@a.Ciudad</td>
                <td>@a.Pais</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted">No se encontraron aeropuertos.</td></tr>
        }
    </tbody>
</table>
