@{
    string rol = Context.Session.GetString("rol");
    bool logueado = !string.IsNullOrEmpty(Context.Session.GetString("token"));
    string nombre = Context.Session.GetString("nombre");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AeroGate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">✈️ AeroGate</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (logueado)
                        {
                            @if (rol == "ADMINISTRADOR")
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Vuelo" asp-action="Index">Vuelos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Aeropuerto" asp-action="Index">Aeropuertos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Usuario" asp-action="Index">Usuarios</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Pasaje" asp-action="PasajerosPorVuelo">Pasajeros x Vuelo</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Auditoria" asp-action="Index">Auditoría</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Pasaje" asp-action="Ranking">Ranking Destinos</a></li>
                            }
                            @if (rol == "OPERADOR")
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Vuelo" asp-action="Index">Vuelos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Aeropuerto" asp-action="Index">Aeropuertos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Pasaje" asp-action="PasajerosPorVuelo">Pasajeros x Vuelo</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Auditoria" asp-action="Index">Auditoría</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Pasaje" asp-action="Ranking">Ranking Destinos</a></li>
                            }
                            @if (rol == "CLIENTE")
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Pasaje" asp-action="Comprar">Comprar Pasaje</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Pasaje" asp-action="MisPasajes">Mis Pasajes</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Pasaje" asp-action="Ranking">Ranking Destinos</a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (logueado)
                        {
                            <li class="nav-item"><span class="navbar-text me-3">@nombre (@rol)</span></li>
                            <li class="nav-item"><a asp-controller="Login" asp-action="Logout" class="btn btn-outline-danger btn-sm mt-1">Cerrar Sesión</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a asp-controller="Login" asp-action="Registro" class="btn btn-outline-light btn-sm me-2 mt-1">Registrarse</a></li>
                            <li class="nav-item"><a asp-controller="Login" asp-action="Index" class="btn btn-primary btn-sm mt-1">Iniciar Sesión</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Exito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-3">
            &copy; 2026 - AeroGate · Sistema de Gestión de Vuelos y Pasajes
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
