@model List<VMAuditoria>
@{
    ViewData["Title"] = "Auditoría";
    string rol = Context.Session.GetString("rol");
}

<h2 class="mb-1">Auditoría de Operaciones</h2>
<p class="text-muted mb-3">
    @(rol == "ADMINISTRADOR" ? "Todas las operaciones del sistema." : "Solo las operaciones realizadas por vos.")
</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="operacion" class="form-select">
            <option value="">Todas las operaciones</option>
            @foreach (string op in (List<string>)ViewBag.Operaciones)
            {
                <option value="@op" selected="@(op == (string)ViewBag.Operacion)">@op</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="date" name="desde" value="@(ViewBag.Desde != null ? ((DateTime)ViewBag.Desde).ToString("yyyy-MM-dd") : "")" class="form-control" />
    </div>
    <div class="col-auto">
        <input type="date" name="hasta" value="@(ViewBag.Hasta != null ? ((DateTime)ViewBag.Hasta).ToString("yyyy-MM-dd") : "")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Fecha y hora</th>
            <th>Operación</th>
            <th>Detalle</th>
            <th>Realizada por</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td><span class="badge bg-dark">@a.Operacion</span></td>
                <td>@a.Detalle</td>
                <td>@a.UsuarioNombre <small class="text-muted">(@a.UsuarioEmail)</small></td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-center text-muted">No hay registros para los filtros seleccionados.</td></tr>
        }
    </tbody>
</table>
