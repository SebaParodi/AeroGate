@model VMAltaEmpleado
@{
    ViewData["Title"] = "Nuevo Empleado";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-4">Alta de Empleado</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Create">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Apellido</label>
                    <input asp-for="Apellido" class="form-control" required />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input asp-for="Pass" type="password" class="form-control" required />
                <div class="form-text">Mínimo 8 caracteres, una mayúscula, un número y un carácter especial.</div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Rol</label>
                    <select asp-for="Rol" class="form-select" required>
                        <option value="">Seleccionar...</option>
                        <option value="ADMINISTRADOR">Administrador</option>
                        <option value="OPERADOR">Operador</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Fecha de ingreso</label>
                    <input asp-for="FechaIngreso" type="date" class="form-control" required />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Crear</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
