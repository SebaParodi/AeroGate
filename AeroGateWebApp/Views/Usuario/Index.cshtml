@model List<VMUsuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Usuarios del Sistema</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Empleado</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Categoría</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.NombreCompleto</td>
                <td>@u.Email</td>
                <td>
                    <span class="badge @(u.Rol == "ADMINISTRADOR" ? "bg-danger" : u.Rol == "OPERADOR" ? "bg-warning text-dark" : "bg-success")">
                        @u.Rol
                    </span>
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(u.Categoria))
                    {
                        <span class="badge bg-info text-dark">@u.Categoria</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
