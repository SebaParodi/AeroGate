@model VMModificarVuelo
@{
    ViewData["Title"] = "Editar Vuelo";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-1">Editar Vuelo @Model.Codigo</h2>
        <p class="text-muted mb-4">Ruta actual: @ViewBag.OrigenActual → @ViewBag.DestinoActual</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Codigo" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Aeropuerto de origen</label>
                    <select asp-for="AeropuertoOrigenId" asp-items="ViewBag.Aeropuertos" class="form-select" required>
                        <option value="">Seleccionar...</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Aeropuerto de destino</label>
                    <select asp-for="AeropuertoDestinoId" asp-items="ViewBag.Aeropuertos" class="form-select" required>
                        <option value="">Seleccionar...</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Fecha y hora de salida</label>
                    <input asp-for="FechaSalida" type="datetime-local" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Llegada estimada</label>
                    <input asp-for="FechaLlegadaEstimada" type="datetime-local" class="form-control" required />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Precio base (USD)</label>
                    <input asp-for="PrecioBase" type="number" step="0.01" min="1" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Capacidad de asientos</label>
                    <input asp-for="CapacidadAsientos" type="number" min="1" class="form-control" required />
                    <div class="form-text">No puede ser menor que los asientos ya vendidos.</div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
